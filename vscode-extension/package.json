{
  "name": "stackport",
  "displayName": "StackPort",
  "description": "Universal AWS resource browser for local emulators (MiniStack, LocalStack, Moto)",
  "version": "0.1.0",
  "publisher": "DaviReisVieira",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "aws",
    "localstack",
    "cloud",
    "emulator",
    "developer-tools"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/DaviReisVieira/stackport"
  },
  "bugs": {
    "url": "https://github.com/DaviReisVieira/stackport/issues"
  },
  "homepage": "https://github.com/DaviReisVieira/stackport",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^2.22.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "stackport",
          "title": "StackPort",
          "icon": "icon.png"
        }
      ]
    },
    "views": {
      "stackport": [
        {
          "id": "stackport-explorer",
          "name": "AWS Resources",
          "icon": "icon.png"
        }
      ]
    },
    "configuration": {
      "title": "StackPort",
      "properties": {
        "stackport.endpoint": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "StackPort backend endpoint URL"
        }
      }
    },
    "commands": [
      {
        "command": "stackport.refreshEntry",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "stackport.invokeLambda",
        "title": "StackPort: Invoke Lambda Function",
        "category": "StackPort"
      },
      {
        "command": "stackport.sendSqsMessage",
        "title": "StackPort: Send SQS Message",
        "category": "StackPort"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "stackport.refreshEntry",
          "when": "view == stackport-explorer",
          "group": "navigation"
        }
      ]
    }
  }
}
